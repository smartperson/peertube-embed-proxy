PORT=3000

# Host used for GET /w/:id (no explicit host segment).
DEFAULT_HOST=video.nyc

# API base for DEFAULT_HOST. Loopback because this normally runs on the same
# box as PeerTube -- skips a TLS round trip. Point this at the PeerTube
# container's address if run in docker compose instead.
LOCAL_API_BASE=http://127.0.0.1:9000

# GET /w/:host/:id lets a single deployment proxy other instances. Off by
# default -- enabling without ALLOWED_HOSTS turns this into an open outbound
# proxy.
MULTI_INSTANCE_ENABLED=false
ALLOWED_HOSTS=

# How long a fetched video's metadata is cached, and how long a failed fetch
# (private/missing/unreachable) is cached before retrying.
CACHE_TTL_MS=3600000
NEGATIVE_CACHE_TTL_MS=300000

# Byte budget for picking a file to embed -- highest resolution that fits.
# ?q=<resolution> on a request overrides this for that link.
DEFAULT_BUDGET_BYTES=26214400

# In-process rate limiting (every request triggers an outbound API call).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Set to true (or a hop count) when running behind Caddy/a load balancer,
# so req.ip reflects the real client.
TRUST_PROXY=true
